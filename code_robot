from lesson_header import *

cups= 1 # what cup you are up to.
DEFAULT_DISTANCE = 15 # expected distance between cups.
MAX_CUPS = 4 # maximum expected cups to go around.
action_log_list = [] # save logs to list.

# save and print function.
def save_log_and_print(log_string):
    action_log_list.append(log_string)
    print(log_string)

# do the thing.
while cups <= MAX_CUPS:

    """
    goal is to make the robot reach the end by calculating the distance of how far 
    away/how close a cup is and to go around the cup if the distance is greater than 
    15 if it is greater than 15 it moves 1.5 to the left or to the right till it 
    passes all 4 of the cups without crashing into any cups on the way.
    """
    distance_cm = sonar.get_distance_cm(filtered=True)

    save_log_and_print(f"Distance: {distance_cm} : Cups: {cups}")

    if distance_cm  > DEFAULT_DISTANCE:

        moves.forward(0.2)

    else:

        if cups == 1:
            
            save_log_and_print("cup 1") # every time robot passes print cup_number it passed.
            moves.move_right(1.5) # tell robout to move.
            cups +=1 # update cups number every time it passes a cup starting from 1 ending at 4.

        elif cups == 2:
            save_log_and_print("cup 2") 
            moves.move_left(1.5)
           
            cups +=1

        elif cups == 3:

            moves.move_right(1.5)
            save_log_and_print("cup 3") 

            cups +=1

        elif cups == 4:

            moves.move_left(1.5) 
            save_log_and_print("cup 4") 

            cups +=1
        else: 
            save_log_and_print("warning: running after should be finished") 

 
moves.forward(1)
save_log_and_print("finished") 

 
